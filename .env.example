# Copy to .env at the repository root. Never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/cryptum?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth web client. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLAG_SECRET=replace-with-an-independent-random-secret
ORGANIZER_TOKEN=replace-with-an-independent-random-secret
# Used only by the development seed; don't distribute in production.
DEV_TEAM_ACCESS_CODE=replace-with-a-team-access-code
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
