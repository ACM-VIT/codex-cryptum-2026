# Copy to .env at the repository root. Never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/cryptum?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth web client. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLAG_SECRET=replace-with-an-independent-random-secret
ORGANIZER_TOKEN=replace-with-an-independent-random-secret
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna

# Private CPU classifier bridge. Generate one random >=32-byte token; share it only
# between the Next.js server and Python classifier process. Never use NEXT_PUBLIC_.
CRYPTUM_CLASSIFIER_URL=http://127.0.0.1:8091
CRYPTUM_CLASSIFIER_TOKEN=

# Native Python security pipeline only; Next.js retains its LLM_* settings above.
# Put these in security/.env for the Python demo/runtime; never use NEXT_PUBLIC_.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
