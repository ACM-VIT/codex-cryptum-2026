{
  "name": "codex-cryptum-2026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "codex.acmvit.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
