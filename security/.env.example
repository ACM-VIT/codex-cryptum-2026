# Placeholders only. Use your secret manager to supply a random >=32-byte secret.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
CRYPTUM_FLAG_MASTER_SECRET_HEX=REPLACE_WITH_64_OR_MORE_RANDOM_HEX_CHARACTERS
CRYPTUM_FLAG_ROTATION=2026-event-v1
# Development only: copy Level 7's documented development value here locally.
CRYPTUM_LEVEL7_FLAG=REPLACE_WITH_A_VALID_cdx_FLAG
# Native Python inference only. The classifier-only bridge never calls an LLM.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_TOKEN_PARAMETER=max_completion_tokens
# Optional: set only if your selected OpenAI model supports it.
# OPENAI_REASONING_EFFORT=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional; model artifacts stay outside the repository by default.
# HF_HOME=~/.cache/huggingface
# Optional dedicated model download cache; ~ is expanded on Linux and macOS.
# CRYPTUM_MODEL_CACHE=~/.cache/cryptum-models
CRYPTUM_CLASSIFIER_THREADS=2
# After python -m security.deploy prepare succeeds, set this in backend runtime:
# HF_HUB_OFFLINE=1

# Private CPU classifier bridge. Generate one random >=32-byte token; share it only
# between the Next.js server and Python classifier process. Never use NEXT_PUBLIC_.
CRYPTUM_CLASSIFIER_URL=http://127.0.0.1:8091
CRYPTUM_CLASSIFIER_TOKEN=

# Bounded HTTP admission wait, included in the existing classifier timeout (0-30 s).
CRYPTUM_CLASSIFIER_QUEUE_TIMEOUT_SECONDS=5
